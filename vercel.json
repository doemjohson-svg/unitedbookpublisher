{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/customer-reviews",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/case-study/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/protect-yourself-from-impersonators",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/genre-guide",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blogs",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blogs/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html|htm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}